<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>BundleRecompressCli.Worker</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Версия AssetsTools.NET, с которой собирается и тестируется утилита.
       SHA-256 сборочной DLL проверяется в CI. У пользователя Bootstrap
       (BundleRecompressCli.exe) может обновить DLL до новой совместимой
       версии из NuGet. -->
  <ItemGroup>
    <Compile Remove="Bootstrap\**" />
    <None Remove="Bootstrap\**" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
